{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Management permissions for the DataNexa main window, excluding write approval",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-get-app-snapshot",
    "allow-get-boot-status",
    "allow-reset-corrupt-config",
    "allow-open-config-directory",
    "allow-exit-app",
    "allow-restart-app",
    "allow-get-jdbc-status",
    "allow-install-jdbc-runtime",
    "allow-remove-jdbc-runtime",
    "allow-check-jdbc-runtime-update",
    "allow-check-jdbc-runtime-update-if-due",
    "allow-get-jdbc-storage-status",
    "allow-clear-jdbc-cache",
    "allow-stop-jdbc-driver-runtime",
    "allow-install-jdbc-driver",
    "allow-import-jdbc-driver",
    "allow-delete-jdbc-driver",
    "allow-create-access-token",
    "allow-rename-access-token",
    "allow-set-access-token-enabled",
    "allow-rotate-access-token",
    "allow-delete-access-token",
    "allow-get-access-token-secret",
    "allow-set-token-connection-allowed",
    "allow-set-token-tool-allowed",
    "allow-set-token-write-allowed",
    "allow-get-write-schemas",
    "allow-get-write-tables",
    "allow-open-write-approval",
    "allow-save-write-configuration",
    "allow-preview-write-approval",
    "allow-save-server-config",
    "allow-save-settings-config",
    "allow-log-frontend-event",
    "allow-open-debug-log-directory",
    "allow-export-connections",
    "allow-import-connections",
    "allow-inspect-connection-file",
    "allow-set-mcp-tool-enabled",
    "allow-set-window-material-theme",
    "allow-upsert-connection",
    "allow-delete-connection",
    "allow-set-connection-enabled",
    "allow-disable-all-connections",
    "allow-clear-audit-events",
    "allow-retry-audit-migration",
    "allow-clear-legacy-audit-log",
    "allow-test-connection",
    "allow-test-connection-input",
    "allow-diagnose-connection",
    "allow-start-mcp-server",
    "allow-stop-mcp-server",
    "allow-minimize-main-window",
    "allow-hide-main-window",
    "allow-start-window-drag",
    "allow-open-data-directory",
    "allow-open-project-homepage",
    "allow-open-project-releases",
    "allow-open-project-site",
    "allow-open-project-issues",
    "allow-open-project-changelog",
    "allow-open-project-help",
    "allow-open-github-acceleration-provider",
    "allow-policy-check",
    "allow-check-updates-if-due",
    "allow-check-app-update",
    "allow-install-app-update"
  ]
}
